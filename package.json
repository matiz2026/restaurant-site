{
  "name": "matiz-restaurant-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "dev:worker": "node --experimental-strip-types scripts/dev.mjs --worker",
    "dev:fallback": "node --experimental-strip-types scripts/dev.mjs --fallback",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "node --experimental-strip-types --test test/app.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply matiz-d1-local --local",
    "admin:reset": "node --experimental-strip-types scripts/reset-admin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.161.0"
  }
}
