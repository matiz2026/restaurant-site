{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local placeholder only. This Worker has not been created on the Cloudflare account.
  // Replace the name before any deploy, and do not deploy until that is intentional.
  "name": "matiz-worker-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      // A single restaurant site is low traffic, so keep traces on while the dashboard is new.
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Local placeholder names. Create the real D1 database on the Cloudflare account
      // before any command that is not marked --local, then replace both fields below.
      "database_name": "matiz-d1-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ]
}
