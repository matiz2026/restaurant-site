{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matiz",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      // A single restaurant site is low traffic, so keep traces on while the dashboard is new.
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": ["SESSION_SECRET"]
  },
  "routes": [
    { "pattern": "matizpr.com", "custom_domain": true },
    { "pattern": "www.matizpr.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "matiz",
      "database_id": "eaccc228-fee8-4218-86f8-3b90cec68c45",
      "migrations_dir": "migrations",
      "remote": false
    }
  ]
}
